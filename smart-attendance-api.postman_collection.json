      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Auto Save Student JWT Token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.role).to.eql('STUDENT');",
              "    pm.collectionVariables.set(\"student_token\", jsonData.data.accessToken);",
              "    pm.collectionVariables.set(\"jwt_token\", jsonData.data.accessToken);",
              "    console.log(\"Saved Student Token:\", jsonData.data.accessToken);",
              "});"
            ],
            "type": "text/javascript"
          }
