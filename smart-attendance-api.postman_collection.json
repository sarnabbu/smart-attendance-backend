{
  "info": {
    "_postman_id": "bbu-smart-attendance-week1-security",
    "name": "BBU Smart Attendance System - Enterprise Security & API Test Suite",
    "description": "សំណុំតេស្ត RESTful API និង Security Hardening ពេញលេញ សម្រាប់គម្រោងសារណា BBU IT (សាកលវិទ្យាល័យបៀលប្រាយ)\nរួមបញ្ចូលទាំងការធ្វើតេស្ត Authentication, RBAC (Role-Based Access Control), ABAC (Data Privacy), និង Privilege Escalation Prevention\nរៀបចំដោយនិស្សិត ខី វណ្ណារ៉ុង (Team Leader & System Architect)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "student_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "class_invite_code",
      "value": "BBU-7X9K",
      "type": "string"
    },
    {
      "key": "class_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. ចុះឈ្មោះសិស្សថ្មី (Register Student - 201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response success is true with STUDENT role\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.role).to.eql('STUDENT');",
              "    pm.expect(jsonData.data.accessToken).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sril Mengty\",\n  \"email\": \"mengty@bbu.edu.kh\",\n  \"password\": \"password123\",\n  \"role\": \"STUDENT\",\n  \"studentCode\": \"BBU-STU-001\",\n  \"phone\": \"012345678\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Endpoint ចុះឈ្មោះគណនីសិស្សថ្មី។ Role ត្រូវតែជា STUDENT។"
      }
    },
